# ==========================================
# RRVDXB AI Chatbot — Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git. It is already in .gitignore.
# Every key below is a setting in app/core/config.py (a test keeps them in sync).
# ==========================================

# App display name
APP_NAME=RRVDXB AI Shopping Chatbot

# Runtime environment: development | test | production
APP_ENV=development

# Debug mode (True for local dev, False for production)
DEBUG=True

# --- Database ---
# SQLite for local development, or PostgreSQL, e.g.
#   postgresql+psycopg://user:password@host:5432/dbname
# (postgres:// and postgresql:// URLs are mapped to psycopg 3 automatically)
DATABASE_URL=sqlite:///./rrvdxb.db

# Run `alembic upgrade head` at startup. Set False when running several
# instances and apply migrations once as a release step instead.
DB_AUTO_MIGRATE=True

# --- LLM (Groq) ---
# Get a key from: https://console.groq.com/keys
GROQ_API_KEY=gsk-your-groq-key-here
LLM_MODEL=llama-3.1-8b-instant

# --- Auth (HS256 bearer tokens) ---
# Required, at least 32 characters (the app refuses to start otherwise,
# unless APP_ENV=test). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_JWT_SECRET=
JWT_ISSUER=rrvdxb-chatbot
JWT_AUDIENCE=rrvdxb-chat

# --- Public demo tokens (POST /api/v1/auth/demo-token) ---
# Off by default (the route answers 404). Turn on only for a public demo.
DEMO_TOKENS_ENABLED=False
DEMO_TOKEN_TTL_SECONDS=1800
DEMO_TOKEN_RATE_PER_MINUTE=5

# --- Time budget per chat request (seconds) ---
REQUEST_BUDGET_SECONDS=4.0
INTENT_TIMEOUT_SECONDS=1.0
RETRIEVAL_TIMEOUT_SECONDS=1.0
LLM_TIMEOUT_SECONDS=3.0

# --- Rate limiting ---
# Max chat requests per minute per verified user (sliding window)
RATE_LIMIT_PER_MINUTE=20
# Max chat requests per minute per client IP (on top of the per-user limit)
CHAT_IP_RATE_PER_MINUTE=20

# --- Client IP behind a reverse proxy ---
# True only behind a proxy that appends the client IP to X-Forwarded-For
# (e.g. Google Cloud Run). The entry TRUST_PROXY_HOPS places from the right
# is used; entries further left are client-supplied and ignored.
TRUST_PROXY=False
TRUST_PROXY_HOPS=1
