# ==========================================
# RRVDXB AI Chatbot — Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git. It is already in .gitignore.
# ==========================================

# SQLAlchemy database URI
# SQLite for local development. Switch to PostgreSQL in production.
DATABASE_URL=sqlite:///./rrvdxb.db

# LLM Provider: "openai" or "groq"
LLM_PROVIDER=groq

# OpenAI API Key (used if LLM_PROVIDER=openai)
# Get yours from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Groq API Key (used if LLM_PROVIDER=groq)
# Get yours from: https://console.groq.com/keys
GROQ_API_KEY=gsk-your-groq-key-here

# LLM Model selection
# OpenAI options: gpt-3.5-turbo, gpt-4, gpt-4-turbo
# Groq options: llama-3.1-8b-instant, llama3-70b-8192, mixtral-8x7b-32768, gemma-7b-it
LLM_MODEL=llama-3.1-8b-instant

# Internal JWT Secret
# Used for signing internal service tokens.
# MUST be at least 32 characters and rotated regularly in production.
INTERNAL_JWT_SECRET=replace-this-with-a-secure-random-string-min-32-chars

# Debug mode (True for local dev, False for production)
DEBUG=True

# Hard ceiling for the Groq LLM call in seconds (must stay under the 4s NFR)
LLM_TIMEOUT_SECONDS=3.0

# Per-user rate limit: max chat requests per minute (sliding window)
# Default 20 — raise for heavy traffic, lower for stricter abuse control.
RATE_LIMIT_PER_MINUTE=20